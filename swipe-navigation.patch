+        swipeActions.value = actions
+        screenModelScope.launch { settingsRepository.putSwipeActions(actions) }
+    }
+
+    fun startLearningRemoteButton() {
+        RemoteLearningSession.step.value = RemoteLearningStep.WaitingForFirstPress
+    }
+
+    fun cancelLearningRemoteButton() {
+        RemoteLearningSession.step.value = RemoteLearningStep.Idle
+    }
+
+    fun onRemoteInputCaptured(input: LearnedReaderGesture) {
+        when (val current = RemoteLearningSession.step.value) {
+            RemoteLearningStep.WaitingForFirstPress -> {
+                RemoteLearningSession.step.value = RemoteLearningStep.ChooseAction(input)
+            }
+
+            is RemoteLearningStep.WaitingForRotatedPress -> {
+                if (input.landscape == current.firstInput.landscape) {
+                    // Pressed before rotating: keep waiting and remind the user to rotate.
+                    RemoteLearningSession.step.value = current.copy(stillSameOrientation = true)
+                } else {
+                    saveLearnedRemoteInput(input.copy(action = current.firstInput.action))
+                    RemoteLearningSession.step.value = RemoteLearningStep.Idle
+                    appNotifications.add(AppNotification.Success("Remote button learned"))
+                }
+            }
+
+            else -> {}
+        }
+    }
+
+    /** Saves the first press with [action] right away, then asks for the rotated press. */
+    fun onRemoteActionChosen(action: ReaderSwipeAction) {
+        val current = RemoteLearningSession.step.value as? RemoteLearningStep.ChooseAction ?: return
+        val firstInput = current.firstInput.copy(action = action)
+        saveLearnedRemoteInput(firstInput)
+        RemoteLearningSession.step.value = RemoteLearningStep.WaitingForRotatedPress(firstInput)
+    }
+
+    fun skipRotatedRemoteInput() {
+        RemoteLearningSession.step.value = RemoteLearningStep.Idle
+        appNotifications.add(AppNotification.Normal("Remote button learned for one orientation"))
+    }
+
+    /** Adds [input], replacing any earlier copy of the same input. */
+    private fun saveLearnedRemoteInput(input: LearnedReaderGesture) {
+        val current = swipeActions.value
+        onSwipeActionsChange(current.copy(learned = current.learned.filterNot { it.matches(input) } + input))
+    }
+
     fun onClearImageCache() {
         clearImageCache()
         appNotifications.add(AppNotification.Success("Cleared image cache"))
