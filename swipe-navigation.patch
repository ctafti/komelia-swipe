+package snd.komelia.db.tables
+
+import org.jetbrains.exposed.v1.core.Table
+
+/**
+ * Swipe navigation settings for the paged/panels image reader.
+ *
+ * Kept in its own table and created with SchemaUtils (CREATE TABLE IF NOT EXISTS)
+ * instead of a Flyway migration, so it can never clash with migration
+ * versions added upstream.
+ */
+object ImageReaderSwipeSettingsTable : Table("KomeliaSwipeNavigation") {
+    val bookId = text("book_id")
+    val swipeLeft = text("swipe_left")
+    val swipeRight = text("swipe_right")
+    val swipeUp = text("swipe_up")
+    val swipeDown = text("swipe_down")
+
+    /** JSON list of learned remote inputs */
+    val learnedGestures = text("learned_gestures").default("[]")
+
+    override val primaryKey = PrimaryKey(bookId)
+}
