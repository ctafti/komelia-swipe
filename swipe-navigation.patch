diff --git a/komelia-ui/src/commonMain/kotlin/snd/komelia/ui/reader/epub/EpubNavigationBridge.kt b/komelia-ui/src/commonMain/kotlin/snd/komelia/ui/reader/epub/EpubNavigationBridge.kt
