diff --git a/komelia-ui/src/commonMain/kotlin/snd/komelia/ui/reader/epub/EpubPageTurnBridge.kt b/komelia-ui/src/commonMain/kotlin/snd/komelia/ui/reader/epub/EpubPageTurnBridge.kt
