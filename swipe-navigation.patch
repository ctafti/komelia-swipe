+/**
+ * Full-screen page used to learn a remote button: press it, choose what it does,
+ * rotate the device, press it again.
+ */
+@Composable
+private fun RemoteLearningDialog(
+    step: RemoteLearningStep,
+    onInputCaptured: (LearnedReaderGesture) -> Unit,
+    onActionChosen: (ReaderSwipeAction) -> Unit,
+    onSkipRotation: () -> Unit,
+    onCancel: () -> Unit,
+) {
+    if (step == RemoteLearningStep.Idle) return
+
+    Dialog(onDismissRequest = onCancel, properties = DialogProperties(usePlatformDefaultWidth = false)) {
+        Box(Modifier.fillMaxSize().background(MaterialTheme.colorScheme.surface)) {
+            // Capture area. The buttons below sit on top of it, so tapping them isn't recorded.
+            Box(
+                modifier = Modifier
+                    .fillMaxSize()
+                    .readerSwipeGestures(
+                        enabled = step.isCapturing,
+                        learning = true,
+                        swipeActions = ReaderSwipeActions(),
+                        screenScaleState = null,
+                        onAction = {},
+                        onInputCaptured = onInputCaptured,
+                    )
+                    .hidePointer(true),
+                contentAlignment = Alignment.Center,
+            ) {
+                Column(
+                    modifier = Modifier.padding(32.dp).widthIn(max = 480.dp),
+                    horizontalAlignment = Alignment.CenterHorizontally,
+                    verticalArrangement = Arrangement.spacedBy(12.dp),
+                ) {
+                    when (step) {
+                        RemoteLearningStep.Idle -> {}
+
+                        RemoteLearningStep.WaitingForFirstPress -> {
+                            Text(
+                                "Press a button on your remote",
+                                style = MaterialTheme.typography.headlineSmall,
+                                textAlign = TextAlign.Center,
+                            )
+                            Text("Press it once, the same way you'll use it to turn pages.", textAlign = TextAlign.Center)
+                        }
+
+                        is RemoteLearningStep.ChooseAction -> {
+                            Text(
+                                "Detected: ${step.firstInput.describe()}",
+                                style = MaterialTheme.typography.headlineSmall,
+                                textAlign = TextAlign.Center,
+                            )
+                            Text("What should this button do?", textAlign = TextAlign.Center)
+                        }
+
+                        is RemoteLearningStep.WaitingForRotatedPress -> {
+                            val target = if (step.firstInput.landscape) "portrait" else "landscape"
+                            val current = if (step.firstInput.landscape) "landscape" else "portrait"
+                            Text(
+                                "Rotate to $target, then press the same button again",
+                                style = MaterialTheme.typography.headlineSmall,
+                                textAlign = TextAlign.Center,
+                            )
+                            if (step.stillSameOrientation) {
+                                Text(
+                                    "Still in $current. Turn off rotation lock if the screen won't rotate.",
+                                    color = MaterialTheme.colorScheme.error,
+                                    textAlign = TextAlign.Center,
+                                )
+                            }
+                        }
+                    }
+                }
+            }
+
+            Row(
+                modifier = Modifier.align(Alignment.BottomCenter).padding(24.dp),
+                horizontalArrangement = Arrangement.spacedBy(12.dp),
+            ) {
+                when (step) {
+                    RemoteLearningStep.Idle -> {}
+                    RemoteLearningStep.WaitingForFirstPress -> TextButton(onClick = onCancel) { Text("Cancel") }
+                    is RemoteLearningStep.ChooseAction -> {
+                        TextButton(onClick = onCancel) { Text("Cancel") }
+                        FilledTonalButton(onClick = { onActionChosen(ReaderSwipeAction.PREVIOUS_PAGE) }) {
+                            Text("Previous page")
+                        }
+                        FilledTonalButton(onClick = { onActionChosen(ReaderSwipeAction.NEXT_PAGE) }) {
+                            Text("Next page")
+                        }
+                    }
+
+                    is RemoteLearningStep.WaitingForRotatedPress -> TextButton(onClick = onSkipRotation) { Text("Skip") }
+                }
+            }
+        }
+    }
+}
