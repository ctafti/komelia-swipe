+package snd.komelia.ui.reader.image.common
+
+import androidx.compose.foundation.gestures.awaitEachGesture
+import androidx.compose.foundation.gestures.awaitFirstDown
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.rememberUpdatedState
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.composed
+import androidx.compose.ui.input.pointer.PointerEvent
+import androidx.compose.ui.input.pointer.PointerEventPass
+import androidx.compose.ui.input.pointer.pointerInput
+import androidx.compose.ui.unit.dp
+import snd.komelia.settings.model.LearnedReaderGesture
+import snd.komelia.settings.model.ReaderSwipeAction
+import snd.komelia.settings.model.ReaderSwipeActions
+import snd.komelia.settings.model.ReaderSwipeDirection
+import snd.komelia.ui.reader.image.ScreenScaleState
+import kotlin.math.PI
+import kotlin.math.abs
+import kotlin.math.acos
+import kotlin.math.hypot
+
+/** Swipes slower than this are treated as deliberate drags, not swipes. */
+private const val MAX_SWIPE_DURATION_MS = 1000L
+
+/** Minimum finger travel for a direction swipe. */
+private const val MIN_SWIPE_DISTANCE_DP = 40
+
+/** The main axis must be this many times longer than the other axis. */
+private const val DIRECTION_RATIO = 1.5f
+
+/**
+ * If the page itself moved by more than this fraction of the swipe distance,
+ * the gesture was used to pan a zoomed/tall page and is not treated as a swipe.
+ */
+private const val MAX_PAN_FRACTION = 0.25f
+
+/** Max angle between a new input's direction and a learned one to count as the same button. */
+private const val LEARNED_MAX_ANGLE_DEGREES = 25f
+
+/**
+ * A new input's length may be this many times shorter/longer than the learned one. Lenient on
+ * purpose: a remote's swipe gets cut short when its cursor is near the edge of the screen.
+ */
+private const val LEARNED_MIN_LENGTH_RATIO = 0.5f
+private const val LEARNED_MAX_LENGTH_RATIO = 2f
+
+/** Compose's name for finger input. Finger input is never reserved for learned remote buttons. */
+private const val TOUCH_POINTER_TYPE = "Touch"
+
+/** Movement below this distance counts as a tap rather than a swipe. */
+private const val TAP_THRESHOLD_DP = 16f
+
+/**
+ * Detects reader gestures, including ones emulated by Bluetooth page-turner remotes:
+ *
+ * 1. Learning mode: the next complete input is captured and passed to [onInputCaptured].
+ * 2. Learned inputs: if an input matches a learned one (same pointer type, same start
+ *    point and same movement, within a small tolerance), its action runs. This works
+ *    for remote "taps" too, and takes priority over tap zones and direction swipes.
+ * 3. Direction swipes: left/right/up/down mapped to actions in settings.
+ *
+ * Finger events are observed without being consumed (so tap zones, panning, scrolling and
+ * pinch-zoom keep working); only the final "up" is consumed when an action runs, so the same
+ * gesture can't also trigger the reader's own tap or swipe handling.
+ *
+ * [screenScaleState] is optional (null for readers without zoom, like EPUB). [scrollAxis] marks
+ * readers that scroll, where direction swipes along that axis are ignored so they keep scrolling.
+ */
+/** Axis a reader scrolls along. Direction swipes along this axis are left to the reader (they scroll). */
+enum class ReaderScrollAxis { VERTICAL, HORIZONTAL }
+
+fun Modifier.readerSwipeGestures(
+    enabled: Boolean,
+    learning: Boolean,
+    swipeActions: ReaderSwipeActions,
+    screenScaleState: ScreenScaleState?,
+    onAction: (ReaderSwipeAction) -> Unit,
+    onInputCaptured: (LearnedReaderGesture) -> Unit = {},
+    scrollAxis: ReaderScrollAxis? = null,
+): Modifier = composed {
+    val currentOnAction by rememberUpdatedState(onAction)
+    val currentOnInputCaptured by rememberUpdatedState(onInputCaptured)
+    val currentSwipeActions by rememberUpdatedState(swipeActions)
+    val currentLearning by rememberUpdatedState(learning)
+    val currentScrollAxis by rememberUpdatedState(scrollAxis)
+
+    if (!enabled || (!learning && !swipeActions.isEnabled)) {
+        Modifier
+    } else {
+        Modifier.pointerInput(screenScaleState) {
+            val minDistancePx = MIN_SWIPE_DISTANCE_DP.dp.toPx()
+
+            awaitEachGesture {
+                val down = awaitFirstDown(requireUnconsumed = false, pass = PointerEventPass.Initial)
+                val startPosition = down.position
+                val startTime = down.uptimeMillis
+                val startTransform = screenScaleState?.transformation?.value
+
+                // While learning, and for devices with learned buttons (e.g. a remote that acts as a
+                // stylus), the whole gesture is reserved: nothing else in the reader sees it, so the
+                // remote can't accidentally pan, scroll or hit a tap zone. Fingers ("Touch") are never reserved.
+                val reserved = currentLearning || currentSwipeActions.learned.any {
+                    it.action != ReaderSwipeAction.NONE &&
+                            it.pointerType != TOUCH_POINTER_TYPE &&
+                            it.pointerType == down.type.toString()
+                }
+                if (reserved) down.consume()
+
+                var endPosition = startPosition
+                var endTime = startTime
+                var multiTouch = false
+                var upEvent: PointerEvent? = null
+
+                while (true) {
+                    val event = awaitPointerEvent(PointerEventPass.Initial)
+                    if (reserved) event.changes.forEach { it.consume() }
+                    if (event.changes.count { it.pressed } > 1) multiTouch = true
+
+                    val change = event.changes.firstOrNull { it.id == down.id }
+                    if (change != null) {
+                        endPosition = change.position
+                        endTime = change.uptimeMillis
+                    }
+                    if (event.changes.none { it.pressed }) {
+                        upEvent = event
+                        break
+                    }
+                }
+
+                if (multiTouch) return@awaitEachGesture
+
+                val width = size.width.toFloat().coerceAtLeast(1f)
+                val height = size.height.toFloat().coerceAtLeast(1f)
+                val delta = endPosition - startPosition
+                val input = LearnedReaderGesture(
+                    pointerType = down.type.toString(),
+                    startX = startPosition.x / width,
+                    startY = startPosition.y / height,
+                    deltaX = delta.x.toDp().value,
+                    deltaY = delta.y.toDp().value,
+                    landscape = width > height,
+                    formatVersion = LearnedReaderGesture.CURRENT_FORMAT_VERSION,
+                )
+
+                // 1. Learning: capture this exact input.
+                if (currentLearning) {
+                    upEvent?.changes?.forEach { it.consume() }
+                    currentOnInputCaptured(input)
+                    return@awaitEachGesture
+                }
+
+                // 2. Learned inputs from a remote take priority.
+                val learnedMatch = currentSwipeActions.learned
+                    .filter { it.action != ReaderSwipeAction.NONE && it.matches(input) }
+                    .minByOrNull { it.angleTo(input) }
+                if (learnedMatch != null) {
+                    upEvent?.changes?.forEach { it.consume() }
+                    currentOnAction(learnedMatch.action)
+                    return@awaitEachGesture
+                }
+
+                // A remote with learned buttons only does what it was taught.
+                if (reserved) return@awaitEachGesture
+
+                // 3. Generic direction swipes.
+                if (!currentSwipeActions.directionSwipesEnabled) return@awaitEachGesture
+                if (endTime - startTime > MAX_SWIPE_DURATION_MS) return@awaitEachGesture
+
+                val absX = abs(delta.x)
+                val absY = abs(delta.y)
+                val direction = when {
+                    absX >= minDistancePx && absX >= absY * DIRECTION_RATIO ->
+                        if (delta.x < 0) ReaderSwipeDirection.LEFT else ReaderSwipeDirection.RIGHT
+
+                    absY >= minDistancePx && absY >= absX * DIRECTION_RATIO ->
+                        if (delta.y < 0) ReaderSwipeDirection.UP else ReaderSwipeDirection.DOWN
+
+                    else -> null
+                } ?: return@awaitEachGesture
+
+                // In scrolling readers, swipes along the scroll direction just scroll.
+                val alongScrollAxis = when (currentScrollAxis) {
+                    ReaderScrollAxis.VERTICAL -> direction == ReaderSwipeDirection.UP || direction == ReaderSwipeDirection.DOWN
+                    ReaderScrollAxis.HORIZONTAL -> direction == ReaderSwipeDirection.LEFT || direction == ReaderSwipeDirection.RIGHT
+                    null -> false
+                }
+                if (alongScrollAxis) return@awaitEachGesture
+
+                // Ignore gestures that zoomed or panned the page.
+                if (screenScaleState != null && startTransform != null) {
+                    val endTransform = screenScaleState.transformation.value
+                    if (endTransform.scale != startTransform.scale) return@awaitEachGesture
+                    val panned = (endTransform.offset - startTransform.offset).getDistance()
+                    if (panned > delta.getDistance() * MAX_PAN_FRACTION) return@awaitEachGesture
+                }
+
+                val action = currentSwipeActions.actionFor(direction)
+                if (action != ReaderSwipeAction.NONE) {
+                    // Stops a reader's own swipe handling (e.g. in EPUB readers) from turning a second page.
+                    upEvent?.changes?.forEach { it.consume() }
+                    currentOnAction(action)
+                }
+            }
+        }
+    }
+}
+
+/**
+ * True if [other] is the same input as this one: same device type and orientation, and a movement
+ * in the same direction with a similar length. Where the input starts on screen doesn't matter.
+ */
+fun LearnedReaderGesture.matches(other: LearnedReaderGesture): Boolean {
+    if (pointerType != other.pointerType || landscape != other.landscape) return false
+    val length = hypot(deltaX, deltaY)
+    val otherLength = hypot(other.deltaX, other.deltaY)
+    val isTap = length < TAP_THRESHOLD_DP
+    val otherIsTap = otherLength < TAP_THRESHOLD_DP
+    if (isTap || otherIsTap) return isTap && otherIsTap
+
+    val ratio = otherLength / length
+    if (ratio < LEARNED_MIN_LENGTH_RATIO || ratio > LEARNED_MAX_LENGTH_RATIO) return false
+    return angleTo(other) <= LEARNED_MAX_ANGLE_DEGREES
+}
+
+/** Angle in degrees between the movement directions of two inputs (0 for taps). */
+fun LearnedReaderGesture.angleTo(other: LearnedReaderGesture): Float {
+    val length = hypot(deltaX, deltaY)
+    val otherLength = hypot(other.deltaX, other.deltaY)
+    if (length == 0f || otherLength == 0f) return 0f
+    val cos = ((deltaX * other.deltaX + deltaY * other.deltaY) / (length * otherLength)).coerceIn(-1f, 1f)
+    return acos(cos) * 180f / PI.toFloat()
+}
+
+/** Human readable description, e.g. "swipe left" or "tap". */
+fun LearnedReaderGesture.describe(): String {
+    return when {
+        hypot(deltaX, deltaY) < TAP_THRESHOLD_DP -> "Tap"
+        abs(deltaX) >= abs(deltaY) -> if (deltaX < 0) "Swipe left" else "Swipe right"
+        else -> if (deltaY < 0) "Swipe up" else "Swipe down"
+    }
+}
+
+fun ReaderSwipeAction.label(): String = when (this) {
+    ReaderSwipeAction.NONE -> "Do nothing"
+    ReaderSwipeAction.NEXT_PAGE -> "Next page"
+    ReaderSwipeAction.PREVIOUS_PAGE -> "Previous page"
+}
