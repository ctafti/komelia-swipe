@@ -0,0 +1,48 @@
+package snd.komelia.ui.reader.epub
+
+import kotlinx.coroutines.channels.BufferOverflow
+import kotlinx.coroutines.channels.Channel
+import snd.komelia.settings.model.ReaderSwipeAction
+
+/**
+ * Delivers page turns from Komelia (swipes and learned remote buttons) into an EPUB web reader.
+ *
+ * The web page repeatedly calls the bound function [BIND_NAME]. Each call waits here until a page
+ * turn is requested and then returns "next" or "previous". It returns "closed" when the reader
+ * closes or the web view is recreated (e.g. after rotating), so the old page's loop stops.
+ */
+class EpubPageTurnBridge {
+    private var requests = newChannel()
+
+    /** Call before loading a (new) web view: ends waiting calls from the previous one. */
+    fun reset() {
+        requests.close()
+        requests = newChannel()
+    }
+
+    suspend fun awaitPageTurn(): String {
+        val channel = requests
+        return channel.receiveCatching().getOrNull() ?: CLOSED
+    }
+
+    fun turnPage(action: ReaderSwipeAction) {
+        when (action) {
+            ReaderSwipeAction.NONE -> {}
+            ReaderSwipeAction.NEXT_PAGE -> requests.trySend(NEXT)
+            ReaderSwipeAction.PREVIOUS_PAGE -> requests.trySend(PREVIOUS)
+        }
+    }
+
+    fun close() {
+        requests.close()
+    }
+
+    private fun newChannel() = Channel<String>(capacity = 4, onBufferOverflow = BufferOverflow.DROP_OLDEST)
+
+    companion object {
+        const val BIND_NAME = "komeliaAwaitPageTurn"
+        private const val NEXT = "next"
+        private const val PREVIOUS = "previous"
+        private const val CLOSED = "closed"
+    }
+}
