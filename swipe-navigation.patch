+@Composable
+private fun BoxScope.RemoteInputLearningUi(
+    showLearnButton: Boolean,
+    step: RemoteLearningStep,
+    onStartLearning: () -> Unit,
+    onCancel: () -> Unit,
+    onActionChosen: (ReaderSwipeAction) -> Unit,
+    onSkipRotation: () -> Unit,
+) {
+    if (showLearnButton && step == RemoteLearningStep.Idle) {
+        FilledTonalButton(
+            onClick = onStartLearning,
+            modifier = Modifier.align(Alignment.Center),
+        ) { Text("Learn remote button") }
+    }
+
+    when (step) {
+        RemoteLearningStep.Idle -> {}
+
+        RemoteLearningStep.WaitingForFirstPress -> LearningBanner(
+            message = "Step 1 of 2: press ONE button on your remote.",
+            hint = null,
+            buttonLabel = "Cancel",
+            onButtonClick = onCancel,
+        )
+
+        is RemoteLearningStep.ChooseAction -> AlertDialog(
+            onDismissRequest = onCancel,
+            title = { Text("What should this button do?") },
+            text = {
+                Text(
+                    "Detected: ${step.firstInput.describe()}.\n\n" +
+                            "Next you'll rotate the screen and press the same button again, " +
+                            "so it works in both portrait and landscape."
+                )
+            },
+            confirmButton = {
+                Row {
+                    TextButton(onClick = { onActionChosen(ReaderSwipeAction.PREVIOUS_PAGE) }) { Text("Previous page") }
+                    TextButton(onClick = { onActionChosen(ReaderSwipeAction.NEXT_PAGE) }) { Text("Next page") }
+                }
+            },
+            dismissButton = {
+                TextButton(onClick = onCancel) { Text("Cancel") }
+            },
+        )
+
+        is RemoteLearningStep.WaitingForRotatedPress -> {
+            val target = if (step.firstInput.landscape) "portrait" else "landscape"
+            val current = if (step.firstInput.landscape) "landscape" else "portrait"
+            LearningBanner(
+                message = "Step 2 of 2: rotate to $target, then press the same button again.",
+                hint = if (step.stillSameOrientation) {
+                    "Still in $current. Rotate the screen first (turn off rotation lock if it won't turn)."
+                } else {
+                    null
+                },
+                buttonLabel = "Skip",
+                onButtonClick = onSkipRotation,
+            )
+        }
+    }
+}
+
+@Composable
+private fun BoxScope.LearningBanner(
+    message: String,
+    hint: String?,
+    buttonLabel: String,
+    onButtonClick: () -> Unit,
+) {
+    Surface(
+        modifier = Modifier
+            .align(Alignment.TopCenter)
+            .padding(top = 48.dp, start = 16.dp, end = 16.dp)
+            .widthIn(max = 560.dp),
+        shape = RoundedCornerShape(12.dp),
+        color = MaterialTheme.colorScheme.surfaceVariant,
+        tonalElevation = 4.dp,
+    ) {
+        Row(
+            modifier = Modifier.padding(horizontal = 16.dp, vertical = 8.dp),
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            Column(Modifier.weight(1f, fill = false)) {
+                Text(message)
+                if (hint != null) {
+                    Text(
+                        hint,
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.error,
+                    )
+                }
+            }
+            Spacer(Modifier.width(12.dp))
+            TextButton(onClick = onButtonClick) { Text(buttonLabel) }
+        }
+    }
+}
