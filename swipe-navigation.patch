+package snd.komelia.ui.reader.image
+
+import kotlinx.coroutines.flow.MutableStateFlow
+import snd.komelia.settings.model.LearnedReaderGesture
+
+/**
+ * Steps of teaching the reader a button on a Bluetooth page-turner remote:
+ * press the button, choose what it does, rotate the device, press it again.
+ */
+sealed interface RemoteLearningStep {
+    data object Idle : RemoteLearningStep
+
+    /** Waiting for the first press of a remote button. */
+    data object WaitingForFirstPress : RemoteLearningStep
+
+    /** First press captured; the user picks what the button should do. */
+    data class ChooseAction(val firstInput: LearnedReaderGesture) : RemoteLearningStep
+
+    /**
+     * Waiting for the same button in the other orientation.
+     * [stillSameOrientation] is set when a press arrives before the device was rotated.
+     */
+    data class WaitingForRotatedPress(
+        val firstInput: LearnedReaderGesture,
+        val stillSameOrientation: Boolean = false,
+    ) : RemoteLearningStep
+}
+
+/**
+ * Held for the whole app process rather than inside the reader screen, because on Android
+ * rotating the device recreates the screen and the learning flow must survive that.
+ */
+object RemoteLearningSession {
+    val step = MutableStateFlow<RemoteLearningStep>(RemoteLearningStep.Idle)
+}
+
+val RemoteLearningStep.isCapturing: Boolean
+    get() = this is RemoteLearningStep.WaitingForFirstPress || this is RemoteLearningStep.WaitingForRotatedPress
