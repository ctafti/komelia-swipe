+@Composable
+private fun SwipeNavigationSettings(
+    swipeActions: ReaderSwipeActions,
+    onSwipeActionsChange: (ReaderSwipeActions) -> Unit,
+) {
+    val options = remember { ReaderSwipeAction.entries.map { LabeledEntry(it, it.label()) } }
+    val directions = remember {
+        listOf(
+            ReaderSwipeDirection.LEFT to "Swipe left",
+            ReaderSwipeDirection.RIGHT to "Swipe right",
+            ReaderSwipeDirection.UP to "Swipe up",
+            ReaderSwipeDirection.DOWN to "Swipe down",
+        )
+    }
+
+    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+        HorizontalDivider(Modifier.padding(vertical = 6.dp))
+        SectionHeader(
+            title = "Swipe navigation",
+            details = listOf(
+                "Works in comic and EPUB readers.",
+                "Scrolling comic reader: only swipes across the scroll direction; others still scroll.",
+                "Ignored while moving a zoomed-in page or with the reader menu open.",
+                "EPUB: replaces the reader's own swipe, and can still fire while the EPUB menu is open.",
+                "To turn pages only with remote buttons, set all four to \"Do nothing\".",
+            ),
+        )
+        directions.forEach { (direction, directionLabel) ->
+            val current = swipeActions.actionFor(direction)
+            DropdownChoiceMenu(
+                selectedOption = options.firstOrNull { it.value == current },
+                options = options,
+                onOptionChange = { onSwipeActionsChange(swipeActions.withAction(direction, it.value)) },
+                label = { Text(directionLabel) },
+                inputFieldModifier = Modifier.fillMaxWidth(),
+                modifier = Modifier.fillMaxWidth(),
+            )
+        }
+    }
+}
+
+@Composable
+private fun RemoteButtonSettings(
+    swipeActions: ReaderSwipeActions,
+    onSwipeActionsChange: (ReaderSwipeActions) -> Unit,
+    onLearnClick: () -> Unit,
+) {
+    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+        HorizontalDivider(Modifier.padding(vertical = 6.dp))
+        SectionHeader(
+            title = "Remote buttons",
+            details = listOf(
+                "Teach Komelia the buttons of a Bluetooth page-turner remote. Works in comic and EPUB readers.",
+                "Recognized by swipe direction and length, wherever the remote's cursor is.",
+                "Learn each button in portrait and landscape.",
+                "Once learned, other input from the remote is ignored in readers and its pointer is hidden there.",
+                "Outside the readers, the remote works like a normal pointer.",
+            ),
+        )
+
+        // One row per button, covering both orientations it was learned in.
+        val buttons = swipeActions.learned.groupBy { Triple(it.pointerType, it.describe(), it.action) }
+        if (buttons.isEmpty()) {
+            Text("No buttons learned yet.", style = MaterialTheme.typography.bodyMedium)
+        } else {
+            buttons.forEach { (key, entries) ->
+                val orientations = entries.map { if (it.landscape) "landscape" else "portrait" }
+                    .distinct().sorted().joinToString(" + ")
+                Row(verticalAlignment = Alignment.CenterVertically) {
+                    Column(Modifier.weight(1f)) {
+                        Text("${key.second} \u2192 ${key.third.label()}", style = MaterialTheme.typography.bodyMedium)
+                        Text(orientations, style = MaterialTheme.typography.bodySmall)
+                    }
+                    TextButton(onClick = {
+                        onSwipeActionsChange(swipeActions.copy(learned = swipeActions.learned - entries.toSet()))
+                    }) { Text("Remove") }
+                }
+            }
+        }
+
+        Row(verticalAlignment = Alignment.CenterVertically, horizontalArrangement = Arrangement.spacedBy(8.dp)) {
+            FilledTonalButton(onClick = onLearnClick) { Text("Learn a button") }
+            if (buttons.isNotEmpty()) {
+                TextButton(onClick = { onSwipeActionsChange(swipeActions.copy(learned = emptyList())) }) {
+                    Text("Remove all")
+                }
+            }
+        }
+        HorizontalDivider(Modifier.padding(vertical = 6.dp))
+    }
+}
+
+/** Section title with a "Details" toggle that shows where the feature works and its limits. */
+@Composable
+private fun SectionHeader(title: String, details: List<String>) {
+    var expanded by remember { mutableStateOf(false) }
+    Column {
+        Row(verticalAlignment = Alignment.CenterVertically) {
+            Text(title, style = MaterialTheme.typography.titleMedium, modifier = Modifier.weight(1f))
+            TextButton(onClick = { expanded = !expanded }) { Text(if (expanded) "Hide details" else "Details") }
+        }
+        if (expanded) {
+            details.forEach { detail ->
+                Text(
+                    "\u2022 $detail",
+                    style = MaterialTheme.typography.bodySmall,
+                    modifier = Modifier.padding(start = 8.dp, bottom = 2.dp),
+                )
+            }
+        }
+    }
+}
